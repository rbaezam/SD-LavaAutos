# WashFlow API - Justfile
# Run `just --list` to see available commands

# Default recipe
default:
    @just --list

# Install dependencies
install:
    uv sync --all-extras

# Run the API server in development mode
dev:
    uv run uvicorn washflow_api.main:app --reload --host 0.0.0.0 --port 8000

# Run the API server in production mode
run:
    uv run uvicorn washflow_api.main:app --host 0.0.0.0 --port 8000

# Run database migrations
migrate:
    uv run alembic upgrade head

# Create a new migration
migration message:
    uv run alembic revision --autogenerate -m "{{message}}"

# Rollback last migration
migrate-down:
    uv run alembic downgrade -1

# Run tests
test:
    uv run pytest -v

# Run tests with coverage
test-cov:
    uv run pytest -v --cov=washflow_api --cov-report=html

# Lint code
lint:
    uv run ruff check src tests

# Format code
format:
    uv run ruff format src tests

# Type check
typecheck:
    uv run mypy src

# Run all checks (lint, format, typecheck)
check: lint typecheck
    @echo "All checks passed!"

# Clean generated files
clean:
    rm -rf __pycache__ .pytest_cache .mypy_cache .ruff_cache htmlcov .coverage
    find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
